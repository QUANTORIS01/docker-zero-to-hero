FROM node:22-alpine

WORKDIR /app

# Copy only the manifest files first, so the install step is cached
# and does not re-run on every source code change.
COPY package.json package-lock.json ./

# `npm ci` is like `npm install`, but:
# - It requires package-lock.json (fails if missing).
# - It is faster and more reproducible.
# - It removes node_modules first, so the result is clean.
RUN npm ci

# Copy the rest of the source code.
# In development, this copy will be hidden by the bind mount from compose,
# but we still need it here so the image is self-contained.
COPY . .

EXPOSE 3000

# Vite listens on 0.0.0.0 (set in vite.config.js) so Docker can expose it.
CMD ["npm", "run", "dev"]
