# ─────────────────────────────────────────────────────────
# Compose-level variables
# These are read by `docker compose` when you run it from
# this directory. Copy to `.env` and fill in your values.
# ─────────────────────────────────────────────────────────

# Your Docker Hub username. Used by compose.prod.yaml to pull
# images like:  <username>/bookmarks-backend:1.0.0
DOCKERHUB_USERNAME=your-dockerhub-username
